# Database Configuration
PUBLIC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@timescaledb:5432/nexus_connect
PRIVATE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres-private:5433/nexus_connect_private

# Redis Configuration
REDIS_URL=redis://redis:6379

# Security Keys (Replace with actual values in production)
SECRET_KEY=your-secret-key-min-32-characters-long-here
MASTER_ENCRYPTION_KEY=your-master-key-min-32-characters-long-here

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
