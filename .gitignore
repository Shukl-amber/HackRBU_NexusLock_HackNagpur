.env
.env.local
.env.*.local

# Temporary files
*.tmp
*.bak
.cache/

# Testing
coverage/
.nyc_output/

# Build outputs
dist/
build/

# Docker
docker_data/

# Database
*.db
*.sqlite
*.sqlite3

# Secrets
secrets.json
keys.txt
